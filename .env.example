# Copy to .env and adjust. `docker compose` reads this automatically.
PORTFOLIO_PORT=8095          # LAN port for the site + /admin (web)
PORTFOLIO_ADMIN_PORT=8096    # optional direct admin port

# CHANGE THESE before sharing the admin over your LAN
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Contact-form email notification (optional — the /admin/contact/ inbox
# works regardless). For Gmail: enable 2FA, create an App Password at
# https://myaccount.google.com/apppasswords, and put it in SMTP_PASSWORD.
# Empty SMTP_PASSWORD leaves notify off.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=genghis.lopez@gmail.com
SMTP_PASSWORD=
SMTP_FROM=admin.4rch3.io@pm.me
CONTACT_EMAIL=admin.4rch3.io@pm.me