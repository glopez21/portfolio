# Copy to .env and adjust. `docker compose` reads this automatically.
PORTFOLIO_PORT=8095          # LAN port for the site + /admin (web)
PORTFOLIO_ADMIN_PORT=8096    # optional direct admin port

# CHANGE THESE before sharing the admin over your LAN
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Contact-form owner notify: **relay-free by design.** The durable owner
# record is the JSONL inbox at /admin/contact/ (works regardless), and the
# owner replies from their own mailbox (CONTACT_EMAIL — an independent
# @pm.me Proton address, not this domain's MX). No SMTP relay is wired;
# Gmail cannot relay this mailbox anyway (it rewrites From to its own
# authenticated user, so a @pm.me From can never go out through it). The
# admin's Go notify gate stays off on empty SMTP_HOST; no SMTP creds live
# in .env or the compose files.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
CONTACT_EMAIL=admin.4rch3.io@pm.me